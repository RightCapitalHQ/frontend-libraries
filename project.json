{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "@rightcapital/libraries",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:noop"
    },
    "docs": {
      "executor": "nx:noop"
    },
    "typecheck": {
      "command": "tsc --build --emitDeclarationOnly tsconfig.misc.json",
      "inputs": [
        "{workspaceRoot}/*.ts",
        "{workspaceRoot}/tsconfig.misc.json",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    }
  }
}
