{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "declarationMap": true,
    "target": "es2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "skipLibCheck": true
  }
}
