{
  "name": "@rightcapital/libraries",
  "version": "1.0.2",
  "private": true,
  "repository": "https://github.com/RightCapitalHQ/frontend-libraries",
  "license": "MIT",
  "author": "RightCapital Ecosystem team <npm-publisher@rightcapital.com>",
  "main": "index.js",
  "scripts": {
    "build": "nx run-many -t build",
    "change": "nx release plan",
    "check": "nx release plan:check",
    "commit": "cz",
    "docs": "nx run-many -t docs",
    "fix": "pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier --write .",
    "preinstall": "npx only-allow pnpm",
    "lint": "concurrently pnpm:lint:*",
    "lint:eslint": "eslint --max-warnings=0 .",
    "lint:prettier": "prettier -c .",
    "prepare": "husky",
    "test": "vitest",
    "typecheck": "nx run-many -t typecheck"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/cz-commitlint": "21.2.0",
    "@nx/js": "23.1.1",
    "@rightcapital/eslint-config": "69.0.0",
    "@rightcapital/exceptions": "workspace:*",
    "@rightcapital/prettier-config": "8.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "commitizen": "4.3.2",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "happy-dom": "20.11.2",
    "husky": "9.1.7",
    "inquirer": "12.11.1",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18.16.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx"
    ]
  }
}
