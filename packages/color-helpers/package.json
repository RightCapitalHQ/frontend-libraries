{
  "name": "@rightcapital/color-helpers",
  "version": "3.0.0",
  "description": "Color science related helpers",
  "keywords": [
    "color",
    "color-science",
    "helpers",
    "WCAG",
    "TypeScript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RightCapitalHQ/frontend-libraries.git",
    "directory": "packages/color-helpers"
  },
  "license": "MIT",
  "author": "RightCapital Ecosystem team <npm-publisher@rightcapital.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/color-helpers.d.ts",
      "default": "./lib/color-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/color-helpers.js",
  "typings": "lib/color-helpers.d.ts",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "docs": "pnpm exec typedoc --plugin typedoc-plugin-markdown --tsconfig tsconfig.src.json --modulesFileName modules --out docs src/color-helpers.ts",
    "prepack": "nx build",
    "test": "vitest"
  },
  "devDependencies": {
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
